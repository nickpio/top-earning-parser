{
  "name": "top-earning-parser",
  "version": "2.0.0",
  "description": "RTE100: Roblox Top-Earning 100 index — scraper, EDR model and index engine",
  "main": "index.js",
  "scripts": {
    "pipeline": "tsx src/jobs/runPipeline.ts",
    "scrape": "tsx src/jobs/runPipeline.ts --skip-index",
    "index": "python3 run_index_engine.py --rebalance-today",
    "index:replay": "python3 run_index_engine.py --replay-all",
    "index:validate": "python3 run_index_engine.py --validate",
    "test:engine": "python3 -m pytest"
  },
